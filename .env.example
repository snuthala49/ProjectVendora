# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/outageintel_db"

# ─── SMTP (self-hosted or provider) ─────────────────────────────────────────
SMTP_HOST="smtp.outageintel.org"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="alerts@outageintel.org"
SMTP_PASS="change_me"
SMTP_FROM="OutageIntel Alerts <alerts@outageintel.org>"
# Destination inbox for admin notifications/reports
ADMIN_REPORT_EMAIL="help@outageintel.org"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron security ───────────────────────────────────────────────────────────
# Set a strong secret; include as Authorization: Bearer <secret> when calling
# /api/cron/poll externally (e.g. via Vercel Cron or cron-job.org)
CRON_SECRET="change_me_to_a_long_random_string"
